# CouchDB configuration (passed through to oleduc container)
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
COUCHDB_DATABASE=obsidian
COUCHDB_PORT=5984

# MCP server
MCP_PORT=8000

# LiveSync encryption (set only if you use E2E encryption, and you don't want to pass through the passphrase from the client *recommended* )
# LIVESYNC_PASSPHRASE=

# Persistent data
COUCHDB_DATA=./couchdb-data
